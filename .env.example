# Copia este archivo como .env y cambia los valores. El .env real NUNCA se sube.

# Seguridad (genera una clave con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos
DATABASE_URL=sqlite:///./pokedex.db

# CORS (orígenes permitidos, en formato JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PokeAPI
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT=10
POKEAPI_CACHE_TTL=3600

# Logging y rate limiting
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
